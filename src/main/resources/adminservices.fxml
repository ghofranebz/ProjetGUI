<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.AdminServiceController"
            prefWidth="1200"
            prefHeight="750"
            stylesheets="@style.css"
            styleClass="root">

    <left>
        <VBox spacing="25" styleClass="sidebar">
            <Label text="🐾 PURRLY" styleClass="logo"/>
            <Separator orientation="HORIZONTAL" styleClass="sidebar-divider" maxWidth="Infinity"/>
            <Button text="Accueil" onAction="#goDashboard" styleClass="menu-button"/>
            <Button text="Services" onAction="#goServices" styleClass="menu-button-active"/>

            <!-- 🔥 NOUVEAU BOUTON DANS LA SIDEBAR -->
            <Button text="Admin"
                    onAction="#goAdmin"
                    styleClass="menu-button"/>
        </VBox>
    </left>

    <center>
        <VBox spacing="20" styleClass="content">

            <HBox spacing="15" styleClass="top-line">
                <Label text="Gestion des Services" styleClass="page-title"/>
                <Region HBox.hgrow="ALWAYS"/>

                <Button text="📋 Réservations reçues"
                        onAction="#goGestionReservations"
                        styleClass="primary-button"/>

                <Button text="+ Ajouter service"
                        onAction="#goAddService"
                        styleClass="dark-button"/>
            </HBox>

            <ScrollPane fitToWidth="true"
                        hbarPolicy="NEVER"
                        vbarPolicy="AS_NEEDED"
                        styleClass="scroll-pane">

                <VBox fx:id="servicesContainer"
                      spacing="22"
                      styleClass="cards-container"/>

            </ScrollPane>

        </VBox>
    </center>

</BorderPane>