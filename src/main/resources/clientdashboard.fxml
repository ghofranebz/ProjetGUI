<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.ClientDashboardController"
            prefWidth="1200"
            prefHeight="750"
            stylesheets="@style.css"
            styleClass="root client-app-root">

    <left>
        <VBox spacing="25" styleClass="client-sidebar">
            <Label text="🐾 PURRLY" styleClass="client-logo"/>
            <Separator orientation="HORIZONTAL" styleClass="sidebar-divider" maxWidth="Infinity"/>
            <Button text="Accueil" onAction="#goDashboard" styleClass="client-menu-button-active"/>
            <Button text="Services" onAction="#goServices" styleClass="client-menu-button"/>
            <Button text="Mes réservations" onAction="#goReservations" styleClass="client-menu-button"/>
        </VBox>
    </left>

    <center>
        <VBox spacing="24" styleClass="content client-content">
            <Label text="Espace Client" styleClass="client-page-title"/>
            <Label text="Parcourez les serviceIslems disponibles et réservez en quelques clics."
                   styleClass="client-subtitle"/>

            <VBox spacing="18">
                <Button text="📋  Catalogue des serviceIslems"
                        onAction="#goServices"
                        styleClass="dashboard-card"/>

                <Button text="📅  Mes réservations"
                        onAction="#goReservations"
                        styleClass="dashboard-card"/>
            </VBox>
        </VBox>
    </center>

</BorderPane>
