<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.ClientReservationController"
            prefWidth="1200"
            prefHeight="750"
            stylesheets="@style.css"
            styleClass="root client-app-root">

    <left>
        <VBox spacing="25" styleClass="client-sidebar">
            <Label text="🐾 PURRLY" styleClass="client-logo"/>
            <Separator orientation="HORIZONTAL" styleClass="sidebar-divider" maxWidth="Infinity"/>
            <Button text="Accueil" onAction="#goDashboard" styleClass="client-menu-button"/>
            <Button text="Services" onAction="#goServices" styleClass="client-menu-button"/>
            <Button text="Mes réservations" onAction="#goReservations" styleClass="client-menu-button-active"/>
        </VBox>
    </left>

    <center>
        <VBox spacing="20" styleClass="content client-content">

            <HBox spacing="15" styleClass="top-line">
                <Label text="Mes réservations" styleClass="client-page-title"/>
                <Region HBox.hgrow="ALWAYS"/>

                <TextField fx:id="searchField"
                           promptText="Rechercher par nom de serviceIslem..."
                           prefWidth="250"
                           styleClass="search-field"/>

                <Button text="Rechercher"
                        onAction="#rechercherService"
                        styleClass="primary-button"/>
            </HBox>

            <ScrollPane fitToWidth="true"
                        hbarPolicy="NEVER"
                        vbarPolicy="AS_NEEDED"
                        styleClass="scroll-pane">

                <VBox fx:id="reservationsContainer"
                      spacing="22"
                      styleClass="cards-container"/>

            </ScrollPane>

        </VBox>
    </center>

</BorderPane>
