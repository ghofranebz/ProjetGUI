<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.AdminReservationController"
            prefWidth="1200"
            prefHeight="750"
            stylesheets="@style.css"
            styleClass="root">

    <left>
        <VBox spacing="25" styleClass="sidebar">
            <Label text="🐾 PURRLY" styleClass="logo"/>
            <Separator orientation="HORIZONTAL" styleClass="sidebar-divider" maxWidth="Infinity"/>
            <Button text="Accueil" onAction="#goDashboard" styleClass="menu-button"/>
            <Button text="Services" onAction="#goServices" styleClass="menu-button"/>
            <Button text="Réservations" onAction="#goReservations" styleClass="menu-button-active"/>
        </VBox>
    </left>

    <center>
        <VBox spacing="20" styleClass="content">

            <HBox spacing="15" styleClass="top-line">
                <Label text="Gestion des Réservations" styleClass="page-title"/>
                <Region HBox.hgrow="ALWAYS"/>

                <!-- 🔍 RECHERCHE DE SERVICE -->
                <TextField fx:id="searchField"
                           promptText="🔍 Rechercher un service..."
                           prefWidth="250"
                           styleClass="search-field"/>

                <Button text="Rechercher"
                        onAction="#rechercherService"
                        styleClass="primary-button"/>

                <!-- 🔥 BOUTON "TOUS" SUPPRIMÉ -->
            </HBox>

            <ScrollPane fitToWidth="true"
                        hbarPolicy="NEVER"
                        vbarPolicy="AS_NEEDED"
                        styleClass="scroll-pane">

                <VBox fx:id="reservationsContainer"
                      spacing="22"
                      styleClass="cards-container"/>

            </ScrollPane>

        </VBox>
    </center>

</BorderPane>